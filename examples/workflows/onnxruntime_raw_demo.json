{
  "id": "onnxruntime_raw_demo",
  "name": "onnxruntime_raw_demo",
  "version": "0.1.0",
  "nodes": [
    {
      "id": "read",
      "operator": "opencv.image.read",
      "params": {
        "path": "demo/input/d34084cc1f765c877abcdf2d515cacf3.jpg"
      }
    },
    {
      "id": "onnx",
      "operator": "infer.onnxruntime.run",
      "params": {
        "model_path": "models/generic.onnx",
        "backend": "cpu",
        "input_width": 640,
        "input_height": 640,
        "letterbox": true
      }
    },
    {
      "id": "record",
      "operator": "record.result.json"
    }
  ],
  "edges": [
    {
      "from_node": "read",
      "from_port": "image",
      "to_node": "onnx",
      "to_port": "image"
    },
    {
      "from_node": "onnx",
      "from_port": "raw",
      "to_node": "record",
      "to_port": "data"
    }
  ]
}
