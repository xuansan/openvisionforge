{
  "id": "yolo_onnxruntime_person_demo",
  "name": "yolo_onnxruntime_person_demo",
  "version": "0.2.0",
  "metadata": {
    "model_id": "yolo11n-coco",
    "model_version": "yolo11n"
  },
  "nodes": [
    {
      "id": "read",
      "operator": "opencv.image.read",
      "params": {"path": "demo/input/d34084cc1f765c877abcdf2d515cacf3.jpg"}
    },
    {
      "id": "detect",
      "operator": "infer.ultralytics.yolo11.detect",
      "params": {
        "model_id": "yolo11n-coco",
        "backend": "cpu",
        "score_threshold": 0.25,
        "nms_threshold": 0.45,
        "letterbox": true
      }
    },
    {
      "id": "record_detections",
      "operator": "record.result.json",
      "params": {"output": "records/yolo_onnxruntime_person_demo/detections.json"}
    },
    {
      "id": "record_raw",
      "operator": "record.result.json",
      "params": {"output": "records/yolo_onnxruntime_person_demo/raw.json"}
    }
  ],
  "edges": [
    {"from_node": "read", "from_port": "image", "to_node": "detect", "to_port": "image"},
    {"from_node": "detect", "from_port": "detections", "to_node": "record_detections", "to_port": "data"},
    {"from_node": "detect", "from_port": "raw", "to_node": "record_raw", "to_port": "payload"}
  ]
}
