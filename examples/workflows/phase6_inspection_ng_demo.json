    {"from_node":"measurement","from_port":"measurements","to_node":"rule_broad","to_port":"data"},
    {"from_node":"rule_tight","from_port":"rule","to_node":"combine","to_port":"rule"},
    {"from_node":"rule_broad","from_port":"rule","to_node":"combine","to_port":"rule2"},
