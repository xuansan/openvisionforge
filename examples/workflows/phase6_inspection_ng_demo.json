    {"id":"threshold","operator":"opencv.threshold.fixed","params":{"threshold":128,"max_value":255}},
    {"id":"contours","operator":"opencv.analysis.find_contours","params":{"min_area":100,"max_contours":20}},
    {"id":"draw","operator":"opencv.draw.contours","params":{"thickness":2,"font_scale":0.6}},
    {"id":"save_image","operator":"opencv.image.write","params":{"output":"demo/output/phase6_ng_annotated.png"}},
    {"id":"measurement","operator":"opencv.measure.point_distance","params":{"x1":0,"y1":0,"x2":200,"y2":0}},
    {"id":"rule_tight","operator":"rule.numeric_range","params":{"rule_id":"distance_tight","field":"point_distance","min":190,"max":210}},
    {"id":"rule_broad","operator":"rule.numeric_range","params":{"rule_id":"distance_broad","field":"point_distance","min":0,"max":100}},
    {"id":"combine","operator":"logic.n_of_m","params":{"rule_id":"distance_vote","required_passes":2}},
    {"id":"final","operator":"logic.final_result","params":{"rule_id":"inspection_final"},"execution":{"always_run":true}},
    {"id":"record","operator":"record.result.json","params":{"output":"demo/output/phase6_ng_result.json","product_id":"demo-part-001","batch_id":"demo-batch","calibration_version":"phase5-sample"},"execution":{"always_run":true}},
    {"id":"webhook","operator":"comm.webhook.send","params":{"mode":"outbox","url":"http://localhost/webhook","outbox":"demo/output/phase6_ng_webhook_outbox.json"},"execution":{"always_run":true}}
