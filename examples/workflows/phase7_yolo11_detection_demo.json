{
  "id": "phase7_yolo11_detection_demo",
  "name": "phase7_yolo11_detection_demo",
  "version": "0.1.0",
  "metadata": {
    "product_id": "demo-image",
    "batch_id": "phase7",
    "model_id": "yolo11n-coco",
    "model_version": "yolo11n"
  },
  "nodes": [
    {
      "id": "read",
      "operator": "opencv.image.read",
      "params": {"path": "demo/input/d34084cc1f765c877abcdf2d515cacf3.jpg"}
    },
    {
      "id": "detect",
      "operator": "infer.ultralytics.yolo11.detect",
      "params": {
        "model_id": "yolo11n-coco",
        "backend": "cpu",
        "score_threshold": 0.25,
        "nms_threshold": 0.45,
        "letterbox": true
      }
    },
    {
      "id": "count_rule",
      "operator": "rule.count_range",
      "params": {"rule_id": "detection_count", "min": 1, "max": 100}
    },
    {
      "id": "confidence_rule",
      "operator": "rule.confidence_min",
      "params": {"rule_id": "detection_confidence", "min": 0.25}
    },
    {
      "id": "combine",
      "operator": "logic.all",
      "params": {"rule_id": "inference_rules"}
    },
    {
      "id": "final",
      "operator": "logic.final_result",
      "params": {"rule_id": "phase7_final"},
      "execution": {"always_run": true}
    },
    {
      "id": "draw",
      "operator": "opencv.draw.boxes",
      "params": {"thickness": 2, "font_scale": 0.6}
    },
    {
      "id": "save_image",
      "operator": "opencv.image.write",
      "params": {"output": "demo/output/phase7_yolo11_annotated.png"}
    },
    {
      "id": "record",
      "operator": "record.result.json",
      "params": {
        "output": "demo/output/phase7_yolo11_result.json",
        "product_id": "demo-image",
        "batch_id": "phase7",
        "model_version": "yolo11n"
      },
      "execution": {"always_run": true}
    }
  ],
  "edges": [
    {"from_node": "read", "from_port": "image", "to_node": "detect", "to_port": "image"},
    {"from_node": "detect", "from_port": "detections", "to_node": "count_rule", "to_port": "data"},
    {"from_node": "detect", "from_port": "detections", "to_node": "confidence_rule", "to_port": "data"},
    {"from_node": "count_rule", "from_port": "rule", "to_node": "combine", "to_port": "rule"},
    {"from_node": "confidence_rule", "from_port": "rule", "to_node": "combine", "to_port": "rule2"},
    {"from_node": "combine", "from_port": "rule", "to_node": "final", "to_port": "rule"},
    {"from_node": "read", "from_port": "image", "to_node": "draw", "to_port": "image"},
    {"from_node": "detect", "from_port": "detections", "to_node": "draw", "to_port": "detections"},
    {"from_node": "draw", "from_port": "image", "to_node": "save_image", "to_port": "image"},
    {"from_node": "final", "from_port": "final", "to_node": "record", "to_port": "final"},
    {"from_node": "detect", "from_port": "detections", "to_node": "record", "to_port": "detections"},
    {"from_node": "draw", "from_port": "image", "to_node": "record", "to_port": "annotated"}
  ]
}
